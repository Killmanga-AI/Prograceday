# Copy to .env and replace both placeholders. .env is git-ignored.
# SQL Server requires a strong password: 8+ characters with upper/lower case,
# a digit and a symbol.
SQLSERVER_SA_PASSWORD=ChangeMe_Str0ng!Password

# At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-this-with-a-random-secret-of-at-least-32-characters

# Browser-reachable base URL of the API (used for uploaded image URLs).
RACEDAY_PUBLIC_API_URL=http://localhost:8081
