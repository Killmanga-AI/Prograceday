@model List<EventEnrolmentDto>
@{
    ViewData["Title"] = "Event enrolments";
    var eventItem = ViewBag.Event as EventDto;
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="mb-1">Enrolments</h1>
        <p class="text-secondary mb-0">@eventItem?.EventName</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Events">Back to events</a>
        <a class="btn btn-primary" asp-action="Results" asp-route-id="@eventItem?.EventId">Record results</a>
    </div>
</div>
@if (ViewBag.Error is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
@if (Model.Count == 0)
{
    <div class="alert alert-info">No participants have enrolled yet.</div>
}
else
{
    <div class="card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Participants enrolled in this event</caption>
                <thead><tr><th scope="col">Participant</th><th scope="col">Email</th><th scope="col">Category</th><th scope="col">Enrolled</th><th scope="col">Status</th><th scope="col">Result</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ParticipantName</td>
                            <td>@item.ParticipantEmail</td>
                            <td>@item.CategoryName</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge text-bg-success">@item.Status</span></td>
                            <td>
                                @if (item.HasResult)
                                {
                                    <span class="badge text-bg-primary">Recorded</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
