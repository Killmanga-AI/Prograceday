@model List<JsonElement>
@{ViewData["Title"]="Event enrolments";var ev=ViewBag.Event as EventDto;}
<h1>Enrolments</h1><p class="text-secondary">@ev?.EventName</p><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Enrolled</th><th>Status</th><th>Result</th></tr></thead><tbody>
@foreach(var e in Model){<tr><td>@e.GetProperty("participantName").GetString()</td><td>@e.GetProperty("participantEmail").GetString()</td><td>@e.GetProperty("categoryName").GetString()</td><td>@e.GetProperty("enrolmentDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@e.GetProperty("status").GetString()</td><td>@(e.GetProperty("hasResult").GetBoolean()?"Recorded":"Pending")</td></tr>}
</tbody></table></div>
@if(Model.Count==0){<div class="alert alert-info">No participants have enrolled yet.</div>}
