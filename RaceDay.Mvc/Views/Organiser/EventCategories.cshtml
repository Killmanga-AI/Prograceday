@model List<CategoryDto>
@{ViewData["Title"]="Manage categories"; var ev=ViewBag.Event as EventDto;}
<div class="d-flex justify-content-between align-items-center"><div><h1>Categories</h1><p class="text-secondary">@ev?.EventName</p></div><a class="btn btn-outline-secondary" asp-action="Events">Back to events</a></div>
<div class="row g-3"><div class="col-lg-7"><div class="card p-3"><h4>Current categories</h4><div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Distance</th><th>Capacity</th><th>Enrolled</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td colspan="4"><form asp-action="UpdateCategory" method="post" class="row g-1"><input type="hidden" name="CategoryId" value="@c.CategoryId"/><input type="hidden" name="EventId" value="@c.EventId"/><div class="col-md-4"><input name="CategoryName" class="form-control form-control-sm" value="@c.CategoryName" required/></div><div class="col-md-2"><input name="DistanceKm" type="number" min=".01" step=".01" class="form-control form-control-sm" value="@c.DistanceKm"/></div><div class="col-md-2"><input name="MaxParticipants" type="number" min="1" class="form-control form-control-sm" value="@c.MaxParticipants"/></div><div class="col-md-2 small text-secondary align-self-center">@c.EnrolledCount enrolled</div><div class="col-md-2"><button class="btn btn-sm btn-outline-primary">Update</button></div></form></td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@c.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div></div>
<div class="col-lg-5"><div class="card p-3"><h4>Add category</h4><form asp-action="AddCategory" method="post"><input type="hidden" name="EventId" value="@ev?.EventId"/><div class="mb-3"><label class="form-label">Category name</label><input name="CategoryName" class="form-control" required maxlength="50" placeholder="e.g. 10 km Open"/></div><div class="mb-3"><label class="form-label">Distance (km)</label><input name="DistanceKm" class="form-control" type="number" min=".01" step=".01" value="5" required/></div><div class="mb-3"><label class="form-label">Maximum participants</label><input name="MaxParticipants" class="form-control" type="number" min="1" value="100" required/></div><button class="btn btn-primary">Add category</button></form></div></div></div>
