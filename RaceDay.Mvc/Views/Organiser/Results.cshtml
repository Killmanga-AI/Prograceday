@model List<JsonElement>
@{ViewData["Title"]="Race results";var ev=ViewBag.Event as EventDto;var enrolments=(ViewBag.Enrolments as List<JsonElement>) ?? new List<JsonElement>();}
<h1>Race results</h1><p class="text-secondary">@ev?.EventName</p>
<div class="card p-3 mb-4"><h4>Recorded results</h4><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.GetProperty("participant").GetString()</td><td>@r.GetProperty("category").GetString()</td><td>@r.GetProperty("finishTime").GetString()</td><td>@(r.GetProperty("position").ValueKind==JsonValueKind.Null?"—":r.GetProperty("position").ToString())</td></tr>}</tbody></table></div></div>
<div class="card p-3"><h4>Record a result</h4><form asp-action="AddResult" method="post"><input type="hidden" name="eventId" value="@ev?.EventId"/><div class="mb-3"><label class="form-label">Participant enrolment</label><select name="EnrolmentId" class="form-select" required><option value="">Choose participant</option>@foreach(var e in enrolments.Where(x=>!x.GetProperty("hasResult").GetBoolean())){<option value="@e.GetProperty("enrolmentId").GetInt32()">@e.GetProperty("participantName").GetString() — @e.GetProperty("categoryName").GetString()</option>}</select></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Finish time (HH:MM:SS)</label><input name="FinishTime" type="time" step="1" class="form-control" required/></div><div class="col-md-6 mb-3"><label class="form-label">Position</label><input name="Position" type="number" min="1" class="form-control"/></div></div><button class="btn btn-primary">Save result</button></form></div>
