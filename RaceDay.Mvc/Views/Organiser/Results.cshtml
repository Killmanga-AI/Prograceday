@model List<OrganiserResultDto>
@{
    ViewData["Title"] = "Race results";
    var eventItem = ViewBag.Event as EventDto;
    var enrolments = ViewBag.Enrolments as List<EventEnrolmentDto> ?? [];
    var pending = enrolments.Where(item => !item.HasResult).ToList();
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="mb-1">Race results</h1>
        <p class="text-secondary mb-0">@eventItem?.EventName</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Events">Back to events</a>
</div>
@if (ViewBag.Error is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div class="card p-3 mb-4">
    <h2 class="h5">Recorded results</h2>
    @if (Model.Count == 0)
    {
        <p class="text-secondary mb-0">No results have been captured for this event yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Recorded results</caption>
                <thead><tr><th scope="col">Participant</th><th scope="col">Category</th><th scope="col">Finish time</th><th scope="col">Position</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Participant</td>
                            <td>@item.Category</td>
                            <td class="fw-bold">@item.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td>@(item.Position?.ToString() ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="card p-3">
    <h2 class="h5">Record a result</h2>
    @if (pending.Count == 0)
    {
        <p class="text-secondary mb-0">Every enrolled participant already has a recorded result.</p>
    }
    else
    {
        <form asp-action="AddResult" method="post" data-busy>
            <input type="hidden" name="eventId" value="@eventItem?.EventId" />
            <div class="mb-3">
                <label class="form-label" for="enrolment">Participant enrolment</label>
                <select id="enrolment" name="EnrolmentId" class="form-select" required>
                    <option value="">Choose participant</option>
                    @foreach (var item in pending)
                    {
                        <option value="@item.EnrolmentId">@item.ParticipantName — @item.CategoryName</option>
                    }
                </select>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="finish-time">Finish time (HH:MM:SS)</label>
                    <input id="finish-time" name="FinishTime" type="time" step="1" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="position">Position (optional)</label>
                    <input id="position" name="Position" type="number" min="1" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save result</button>
        </form>
    }
</div>
