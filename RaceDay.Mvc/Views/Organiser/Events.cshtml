@model List<JsonElement>
@{ViewData["Title"]="My events";}
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>My events</h1><p class="text-secondary">Create and manage your sporting events.</p></div><a class="btn btn-primary" asp-action="CreateEvent">+ Create event</a></div>
@if(ViewBag.Error is string err){<div class="alert alert-warning">@err</div>}
<div class="row g-3">@foreach(var e in Model){<div class="col-md-6"><div class="card p-3 h-100"><h4>@e.GetProperty("eventName").GetString()</h4><p class="text-secondary">@e.GetProperty("location").GetString() · @e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</p><p>@e.GetProperty("eventType").GetString() · @e.GetProperty("eventDistanceKm").GetDecimal() km</p><p>@e.GetProperty("categories").GetInt32() categories · @e.GetProperty("enrolments").GetInt32() enrolments</p><div class="d-flex flex-wrap gap-2 mt-auto"><a class="btn btn-sm btn-primary" asp-action="EventCategories" asp-route-id="@e.GetProperty("eventId").GetInt32()">Categories</a><a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-id="@e.GetProperty("eventId").GetInt32()">Enrolments</a><a class="btn btn-sm btn-outline-secondary" asp-action="Results" asp-route-id="@e.GetProperty("eventId").GetInt32()">Results</a><a class="btn btn-sm btn-outline-secondary" asp-action="EditEvent" asp-route-id="@e.GetProperty("eventId").GetInt32()">Edit</a><form asp-action="DeleteEvent" method="post" onsubmit="return confirm('Delete this event and its related categories, enrolments and results?')"><input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}</div>
@if(Model.Count==0){<div class="alert alert-info">You have not created any events yet.</div>}
