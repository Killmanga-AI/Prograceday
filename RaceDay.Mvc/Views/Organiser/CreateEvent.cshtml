@model EventViewModel
@{
    ViewData["Title"] = "Create event";
    ViewData["SubmitLabel"] = "Create event";
}
<div class="card form-card p-4">
    <h1 class="h3">Create event</h1>
    <p class="text-secondary">Add the schedule, route and optional banner. Categories can be added next.</p>
    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" data-busy>
        <partial name="_EventForm" model="Model" />
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
