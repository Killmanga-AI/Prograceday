@model List<ParticipantEnrolmentDto>
@{ ViewData["Title"] = "My events"; }
<h1>My events</h1>
<p class="text-secondary">Your registrations and their current status.</p>
@if (ViewBag.Error is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
@if (Model.Count == 0)
{
    <div class="card p-5 text-center">
        <div class="display-6 mb-2">🏃</div>
        <h2 class="h5">You have not enrolled in any events yet</h2>
        <p class="text-secondary">Find a race that suits you and secure your place.</p>
        <a class="btn btn-primary" asp-action="Browse">Browse events</a>
    </div>
}
else
{
    <div class="card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Your event enrolments</caption>
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Location</th>
                        <th scope="col">Category</th>
                        <th scope="col">Enrolled</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@item.EventId">@item.Event</a></td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.EventLocation</td>
                            <td>@item.Category <span class="text-secondary small">(@item.DistanceKm km)</span></td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge text-bg-success">@item.Status</span></td>
                            <td class="text-end">
                                <form asp-action="Cancel" method="post" class="d-inline" data-busy
                                      data-confirm="Cancel your enrolment for @item.Event?">
                                    <input type="hidden" name="id" value="@item.EnrolmentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
