@model List<EventDto>
@{ViewData["Title"]="Browse events";}
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Upcoming events</h1><p class="text-secondary">Find your next challenge.</p></div></div>
<form method="get" class="card p-3 mb-4"><div class="row g-2"><div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search event or location"/></div><div class="col-md-3"><select name="type" class="form-select"><option value="">All event types</option><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-3"><button class="btn btn-primary w-100">Search events</button></div></div></form>
@if(ViewBag.Error is string err){<div class="alert alert-warning">@err</div>}
<div class="row g-3">
@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="card h-100 overflow-hidden">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img src="@e.BannerImageUrl" class="event-banner" alt="Event banner"/>}else{<div class="bg-dark text-white p-4"><span class="display-6">🏁</span><div class="small">RACEDAY EVENT</div></div>}<div class="card-body"><span class="badge text-bg-warning">@e.EventType</span><h4 class="mt-2">@e.EventName</h4><p class="text-secondary mb-2">@e.Location</p><p class="small">@e.EventDate.ToString("dd MMM yyyy · HH:mm") · @e.EventDistanceKm km</p><a class="btn btn-primary" asp-action="Details" asp-route-id="@e.EventId">View event</a></div></div></div>}
</div>
@if(Model.Count==0){<div class="alert alert-info">No events matched your search.</div>}
