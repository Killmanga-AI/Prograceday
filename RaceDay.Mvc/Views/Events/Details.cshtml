@model EventDto
@{ViewData["Title"]=Model.EventName; var categories=ViewBag.Categories as List<CategoryDto> ?? [];}
@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" class="event-banner mb-3" style="height:280px" alt="Event banner"/>}
<div class="card p-4 mb-3"><span class="badge text-bg-warning align-self-start">@Model.EventType</span><h1 class="mt-2">@Model.EventName</h1><p class="text-secondary">@Model.Description</p><div class="row"><div class="col-md-4"><b>Date</b><p>@Model.EventDate.ToString("dd MMMM yyyy · HH:mm")</p></div><div class="col-md-4"><b>Location</b><p>@Model.Location</p></div><div class="col-md-4"><b>Distance</b><p>@Model.EventDistanceKm km</p></div></div>@if(!string.IsNullOrWhiteSpace(Model.RouteInfo)){<b>Route information</b><p>@Model.RouteInfo</p>}</div>
<h3>Available categories</h3><div class="row g-3">@foreach(var c in categories){<div class="col-md-6"><div class="card p-3"><h5>@c.CategoryName</h5><p class="text-secondary">@c.DistanceKm km · @c.EnrolledCount / @c.MaxParticipants enrolled</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@Model.EventId"/><button class="btn btn-primary" @(c.EnrolledCount>=c.MaxParticipants ? "disabled" : null)>Enrol</button></form>}else if(Context.Session.GetString("Token") is null){<a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Sign in to enrol</a>}</div></div>}</div>
