@model List<JsonElement>
@{ViewData["Title"]="My results";}
<h1>My race results</h1><p class="text-secondary">Your recorded finish times and category positions.</p>
@if(ViewBag.Error is string err){<div class="alert alert-warning">@err</div>}
<div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Event</th><th>Event date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Recorded</th></tr></thead><tbody>
@foreach(var r in Model){<tr><td>@r.GetProperty("event").GetString()</td><td>@r.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@r.GetProperty("category").GetString()</td><td class="fw-bold">@r.GetProperty("finishTime").GetString()</td><td>@(r.GetProperty("position").ValueKind==JsonValueKind.Null?"—":r.GetProperty("position").ToString()) / @r.GetProperty("totalFinishers").GetInt32()</td><td>@r.GetProperty("recordedAt").GetDateTime().ToString("dd MMM yyyy")</td></tr>}
</tbody></table></div>
@if(Model.Count==0){<div class="alert alert-info mt-3">No results have been recorded for your entries yet.</div>}
