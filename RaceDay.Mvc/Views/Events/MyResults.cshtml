@model List<ParticipantResultDto>
@{ ViewData["Title"] = "My results"; }
<h1>My race results</h1>
<p class="text-secondary">Your recorded finish times and category positions.</p>
@if (ViewBag.Error is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
@if (Model.Count == 0)
{
    <div class="card p-5 text-center">
        <div class="display-6 mb-2">⏱️</div>
        <h2 class="h5">No results have been recorded yet</h2>
        <p class="text-secondary">Once an organiser captures your finish time it will appear here.</p>
        <a class="btn btn-outline-primary" asp-action="MyEvents">View my events</a>
    </div>
}
else
{
    <div class="card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Your race results</caption>
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Event date</th>
                        <th scope="col">Category</th>
                        <th scope="col">Finish time</th>
                        <th scope="col">Position</th>
                        <th scope="col">Recorded</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Event<br /><span class="text-secondary small">@item.EventLocation</span></td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Category <span class="text-secondary small">(@item.DistanceKm km)</span></td>
                            <td class="fw-bold">@item.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td>
                                @if (item.Position.HasValue)
                                {
                                    <span>@item.Position / @item.TotalFinishers</span>
                                }
                                else
                                {
                                    <span class="text-secondary">— / @item.TotalFinishers</span>
                                }
                            </td>
                            <td>@item.RecordedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
