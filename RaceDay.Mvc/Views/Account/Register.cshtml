@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card form-card p-4">
            <h1 class="h3">Create your account</h1>
            <p class="text-secondary">Choose the role that matches how you will use RaceDay.</p>
            <form asp-action="Register" method="post" data-busy>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" autofocus />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="form-text">Use at least 8 characters.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="Participant">Participant — browse and enter events</option>
                        <option value="Organiser">Organiser — create and manage events</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Create account</button>
            </form>
            <p class="mt-3 mb-0">Already registered? <a asp-action="Login">Sign in</a>.</p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
