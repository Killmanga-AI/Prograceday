{
  "ConnectionStrings": {
    "RaceDay": "Server=(localdb)\\\\MSSQLLocalDB;Database=RaceDayDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "RaceDay",
    "Audience": "RaceDayClients",
    "Key": "replace-with-a-random-secret-at-least-32-characters"
  },
  "Media": {
    "Provider": "Local",
    "LocalPath": "App_Data/media",
    "PublicBaseUrl": "http://localhost:5171"
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "raceday-media"
  }
}
