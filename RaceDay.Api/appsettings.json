{
  "ConnectionStrings": {
    "RaceDay": "Server=(localdb)\\MSSQLLocalDB;Database=RaceDayDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "RaceDay",
    "Audience": "RaceDayClients"
  },
  "Media": {
    "Provider": "Local",
    "LocalPath": "App_Data/media",
    "PublicBaseUrl": ""
  },
  "Database": {
    "AutoMigrate": false,
    "MigrateMaxAttempts": 12,
    "MigrateRetrySeconds": 5
  },
  "Https": {
    "Redirect": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
